import tkinter as tk
from tkinter import ttk, messagebox
from collections import deque

GRAPH = {
    "A": ["B", "C"],
    "B": ["A", "D", "E"],
    "C": ["A", "F"],
    "D": ["B"],
    "E": ["B", "F"],
    "F": ["C", "E"]
}


def bfs(start, goal):
    queue = deque([[start]])
    visited = {start}

    while queue:
        path = queue.popleft()
        node = path[-1]

        if node == goal:
            return path

        for neighbor in GRAPH[node]:
            if neighbor not in visited:
                visited.add(neighbor)
                queue.append(path + [neighbor])

    return None


def dfs(start, goal):
    stack = [[start]]
    visited = set()

    while stack:
        path = stack.pop()
        node = path[-1]

        if node == goal:
            return path

        if node not in visited:
            visited.add(node)

            for neighbor in reversed(GRAPH[node]):
                if neighbor not in visited:
                    stack.append(path + [neighbor])

    return None

# Menyimpan riwayat hasil pencarian
search_history = []

def search():
    start = start_box.get()
    goal = goal_box.get()
    method = algorithm_box.get()

    if method == "BFS":
        path = bfs(start, goal)
    else:
        path = dfs(start, goal)

    if path:
        result_label.config(
            text="Jalur ditemukan: " + " -> ".join(path)
        )
        draw_graph(path)
        history_entry = f"{method}: {start} -> {goal} | Jalur: {' -> '.join(path)}"
    else:
        result_label.config(text="Jalur tidak ditemukan.")
        draw_graph()
        history_entry = f"{method}: {start} -> {goal} | Jalur tidak ditemukan"

    search_history.append(history_entry)

def show_history():
    if search_history:
        history_text = "\n".join(
            f"{i+1}. {item}"
            for i, item in enumerate(search_history)
        )
    else:
        history_text = "Belum ada riwayat pencarian."

    messagebox.showinfo("Riwayat Pencarian", history_text)
def draw_graph(path=None):
    canvas.delete("all")

    positions = {
        "A": (100, 70),
        "B": (230, 70),
        "C": (100, 190),
        "D": (360, 30),
        "E": (360, 110),
        "F": (230, 220)
    }

    path = path or []

    for node, neighbors in GRAPH.items():
        x1, y1 = positions[node]

        for neighbor in neighbors:
            if node < neighbor:
                x2, y2 = positions[neighbor]
                canvas.create_line(
                    x1, y1, x2, y2, fill="gray", width=2
                )

    for node, (x, y) in positions.items():
        color = "#35a853" if node in path else "#2878c8"
        canvas.create_oval(
            x-20, y-20, x+20, y+20,
            fill=color, outline="white", width=2
        )
        canvas.create_text(
            x, y, text=node, fill="white",
            font=("Arial", 12, "bold")
        )


root = tk.Tk()
root.title("Search Algorithm Visualizer")
root.geometry("520x480")
root.configure(bg="#f0f4f8")

tk.Label(
    root, text="SEARCH ALGORITHM",
    font=("Arial", 18, "bold"),
    bg="#f0f4f8", fg="#174a7e"
).pack(pady=12)

controls = tk.Frame(root, bg="#f0f4f8")
controls.pack()

tk.Label(controls, text="Node awal:", bg="#f0f4f8").grid(row=0, column=0)
start_box = ttk.Combobox(
    controls, values=list(GRAPH), state="readonly", width=8
)
start_box.set("A")
start_box.grid(row=0, column=1, padx=5, pady=5)

tk.Label(controls, text="Node tujuan:", bg="#f0f4f8").grid(row=1, column=0)
goal_box = ttk.Combobox(
    controls, values=list(GRAPH), state="readonly", width=8
)
goal_box.set("F")
goal_box.grid(row=1, column=1, padx=5, pady=5)

tk.Label(controls, text="Algoritma:", bg="#f0f4f8").grid(row=2, column=0)
algorithm_box = ttk.Combobox(
    controls, values=["BFS", "DFS"], state="readonly", width=8
)
algorithm_box.set("BFS")
algorithm_box.grid(row=2, column=1, padx=5, pady=5)

tk.Button(
    root, text="CARI JALUR", command=search,
    bg="#2878c8", fg="white",
    font=("Arial", 11, "bold"), padx=18, pady=6
).pack(pady=10)

canvas = tk.Canvas(root, width=440, height=260, bg="white")
canvas.pack(pady=5)

result_label = tk.Label(
    root, text="Pilih node dan algoritma.",
    bg="#f0f4f8", wraplength=480
)
result_label.pack(pady=8)
tk.Button(
    root,
    text="LIHAT RIWAYAT",
    command=lambda: show_history(),
    bg="#174a7e",
    fg="white",
    font=("Arial", 10, "bold"),
    padx=12,
    pady=5
).pack(pady=(0, 8))
draw_graph()
root.mainloop()

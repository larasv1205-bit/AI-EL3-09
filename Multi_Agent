# ==========================================
# 2. SISTEM MULTI-AGENT
# ==========================================

class MultiAgentSystem:
    def __init__(self):
        self.completed = []
        self.agent_counts = {name: 0 for name in AGENTS}

    def assign(self, task):
        for name, data in AGENTS.items():
            if task in data["skills"]:
                return name
        return None

    def finish(self, agent, task):
        self.completed.append(task)
        self.agent_counts[agent] += 1

    def reset(self):
        self.completed.clear()
        self.agent_counts = {name: 0 for name in AGENTS}



def draw_network(active=None):
    canvas.delete("all")

    width = max(canvas.winfo_width(), 500)
    center = width / 2

    canvas.create_rectangle(
        center - 105, 18,
        center + 105, 85,
        fill="#24549b",
        outline="#69b6ff",
        width=2
    )
    canvas.create_text(
        center, 39,
        text="MANAGER AI",
        fill="white",
        font=("Segoe UI", 15, "bold")
    )
    canvas.create_text(
        center, 65,
        text="Task Coordinator",
        fill="#c6e3ff",
        font=("Segoe UI", 10)
    )

    positions = [
        width * 0.18,
        width * 0.50,
        width * 0.82
    ]

    for i, (name, data) in enumerate(AGENTS.items()):
        x = positions[i]
        selected = name == active

        canvas.create_line(
            center, 85, x, 157,
            fill=data["color"] if selected else "#45617f",
            width=4 if selected else 2,
            arrow=tk.LAST
        )

        canvas.create_oval(
            x - 36, 165,
            x + 36, 237,
            fill=data["color"] if selected else "#243957",
            outline=data["color"],
            width=3
        )

        canvas.create_text(
            x, 190,
            text="AI",
            fill="white",
            font=("Segoe UI", 17, "bold")
        )

        canvas.create_text(
            x, 253,
            text=name,
            fill="white",
            font=("Segoe UI", 11, "bold")
        )



# 5. LOG DAN ANIMASI
# ==========================================

def log(message):
    timestamp = datetime.now().strftime("%H:%M:%S")
    log_box.config(state="normal")
    log_box.insert("end", f"[{timestamp}] {message}\n")
    log_box.see("end")
    log_box.config(state="disabled")


def update_cards(active=None):
    for name, label in agent_labels.items():
        count = system.agent_counts[name]

        if name == active:
            status = "WORKING"
            color = AGENTS[name]["color"]
        elif count > 0:
            status = "COMPLETED"
            color = "#06d6a0"
        else:
            status = "IDLE"
            color = TEXT

        label.config(
            text=f"● {status} | {count} tugas selesai",
            fg=color
        )


def delay():
    return 1400 - speed.get() * 220


def schedule(callback):
    global job_id
    job_id = root.after(delay(), callback)


def process_next():
    global task_index, active_agent, running

    if not running:
        return

    if task_index >= len(tasks_to_run):
        running = False
        active_agent = None
        draw_network()
        update_cards()
        status_label.config(
            text="SIMULATION COMPLETED",
            fg="#06d6a0"
        )
        run_button.config(state="normal")
        log("Simulasi selesai.")
        return

    task = tasks_to_run[task_index]
    agent = system.assign(task)

    if agent is None:
        log(f"Tidak ada agent yang mampu: {task}")
        task_index += 1
        update_progress()
        schedule(process_next)
        return

    active_agent = agent
    draw_network(agent)
    update_cards(agent)

    status_label.config(
        text=f"{agent.upper()} PROCESSING...",
        fg=AGENTS[agent]["color"]
    )

    log(f"Manager → {agent}: {task}")
    schedule(lambda: complete_task(agent, task))


def complete_task(agent, task):
    global task_index, active_agent

    if not running:
        return

    system.finish(agent, task)
    log(f"✓ {agent} menyelesaikan: {task}")

    task_index += 1
    active_agent = None

    draw_network()
    update_cards()
    update_progress()
    schedule(process_next)


def update_progress():
    total = len(tasks_to_run)
    percent = int(task_index / total * 100) if total else 100
    progress["value"] = percent
    progress_text.config(text=f"Progress: {percent}%")


def start_simulation():
    global running, task_index, tasks_to_run

    if running:
        return

    system.reset()
    task_index = 0
    tasks_to_run = list(task_list.get(0, "end"))
    running = True

    log_box.config(state="normal")
    log_box.delete("1.0", "end")
    log_box.config(state="disabled")

    run_button.config(state="disabled")
    progress["value"] = 0
    progress_text.config(text="Progress: 0%")
    update_cards()

    log("Manager AI memulai simulasi.")
    process_next()


def reset_simulation():
    global running, job_id, task_index, active_agent

    running = False

    if job_id is not None:
        root.after_cancel(job_id)
        job_id = None

    system.reset()
    task_index = 0
    active_agent = None

    progress["value"] = 0
    progress_text.config(text="Progress: 0%")
    status_label.config(text="SYSTEM READY", fg="#7edaff")
    run_button.config(state="normal")

    draw_network()
    update_cards()
    log("Sistem di-reset.")


run_button.config(command=start_simulation)
reset_button.config(command=reset_simulation)

